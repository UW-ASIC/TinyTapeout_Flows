#### PDK LOCATION
# `volare enable` maintains $PDK_ROOT/$PDK as a symlink to whichever version is active,
# so that path is always current. Pinning the version hash here instead is what made
# `make schematic` fail: Tcl `source` on a path that does not exist takes xschem down
# with a core dump, and since the recipe backgrounds xschem with `&`, the crash was
# invisible and make still reported success. The `update-pdk` target existed only to sed
# this line back into agreement with reality; nothing to sed, nothing to drift.
set PDK_ROOT [expr {[info exists env(PDK_ROOT)] ? $env(PDK_ROOT) : "$env(HOME)/.volare"}]
set PDK [expr {[info exists env(PDK)] ? $env(PDK) : "sky130A"}]
set PDK_PATH "$PDK_ROOT/$PDK"

if {![file isdirectory $PDK_PATH]} {
    puts stderr "ERROR: no PDK at $PDK_PATH"
    puts stderr "Run 'volare enable --pdk sky130 <version>', or re-enter the nix shell."
    exit 1
}

source $PDK_PATH/libs.tech/xschem/xschemrc

set SKYWATER_MODELS "$PDK_PATH/libs.tech/ngspice"
set SKYWATER_STDCELLS "$PDK_PATH/libs.ref/sky130_fd_sc_hd/spice"

puts "PDK set SKYWATER_MODELS to: $SKYWATER_MODELS"
puts "PDK set SKYWATER_STDCELLS to: $SKYWATER_STDCELLS"

#### PROJECT CONFIGURATION
