append XSCHEM_LIBRARY_PATH :[file dirname [info script]]/../../../library

#### DEPENDENCY BLOCKS
# A top-level block places its sub-blocks' symbols, so those directories have to be on
# the library path too. Read from DEPENDS in ../config.mk rather than globbing every
# sibling: two blocks may each define a symbol of the same name, and a glob would
# silently resolve to whichever directory happened to come first.
set _cfg "[file dirname [info script]]/../config.mk"
if {[file exists $_cfg]} {
    set _fh [open $_cfg r]
    set _cfg_text [read $_fh]
    close $_fh
    foreach _line [split $_cfg_text "\n"] {
        if {[regexp {^\s*DEPENDS\s*=\s*(.*)$} $_line -> _v]} {
            foreach _dep [split [string trim $_v]] {
                if {$_dep eq ""} continue
                set _root "[file dirname [info script]]/../../../$_dep"
                append XSCHEM_LIBRARY_PATH :$_root/symbols
                append XSCHEM_LIBRARY_PATH :$_root/schematics
                puts "block dependency on library path: $_dep"
            }
        }
    }
}

append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library
append XSCHEM_LIBRARY_PATH :$PDK_PATH/libs.tech/xschem


